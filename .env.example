# ==============================================================================
# KONFIGURASI BOT WHATSAPP RPL 2
# ==============================================================================

# Command Prefix (Contoh: ., !, #, /)
PREFIX=.

# Zona Waktu (WITA / UTC+8: Asia/Makassar)
TIMEZONE=Asia/Makassar

# Target WhatsApp Group JID untuk Broadcast Otomatis (Contoh: 120363xxxxxxxxxxxx@g.us)
# Gunakan command .id di dalam grup untuk mendapatkan JID grup
GROUP_JID=120363000000000000@g.us

# Konfigurasi Cron Scheduler (WITA)
# CRON_JADWAL_PAGI: Setiap Senin - Jumat jam 06:00 WITA
CRON_JADWAL_PAGI=0 6 * * 1-5

# CRON_PIKET_MALAM: Setiap Minggu - Kamis jam 20:00 WITA (Pengingat H-1)
CRON_PIKET_MALAM=0 20 * * 0-4

# Path Database SQLite
DB_PATH=./data/bot.sqlite
